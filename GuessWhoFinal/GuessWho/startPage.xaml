<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuessWho.startPage"
             Title="startPage">
    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
        <Label FontSize="30" Text="Welcome to Guess Who!"/>
        <Label FontSize="18" Text="choose the amount of players"/>
        <HorizontalStackLayout Spacing="30" VerticalOptions="Center">
            <Button Text="1 player" Clicked="Button_Clicked"/>
            <Button Text="2 player" Clicked="Button_Clicked"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
